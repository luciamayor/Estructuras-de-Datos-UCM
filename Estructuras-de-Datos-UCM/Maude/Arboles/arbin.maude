fmod ARBOL-BINARIO{X :: TRIV} is

  sort ArbolBin{X} .

  op errorArbol    : -> [ArbolBin{X}] .
  op errorElemento : -> [X$Elt] .

  op  arbol-vacio     : -> ArbolBin{X} [ctor] .
  op  plantar         : ArbolBin{X} X$Elt ArbolBin{X} -> ArbolBin{X} [ctor] .
  ops hijo-iz hijo-dr : ArbolBin{X} -> ArbolBin{X} .
  op raiz             : ArbolBin{X} -> X$Elt .
  op es-arbol-vacio?  : ArbolBin{X} -> Bool .

  vars iz dr : ArbolBin{X} .
  var e : X$Elt .

  eq hijo-iz(arbol-vacio) = errorArbol .
  eq hijo-iz(plantar(iz, e, dr)) = iz .

  eq hijo-dr(arbol-vacio) = errorArbol .
  eq hijo-dr(plantar(iz, e, dr)) = dr .

  eq raiz(arbol-vacio) = errorElemento .
  eq raiz(plantar(iz, e, dr)) = e .

  eq es-arbol-vacio?(arbol-vacio) = true .
  eq es-arbol-vacio?(plantar(iz, e, dr)) = false .

endfm


view vNat from TRIV to NAT is
  sort Elt to Nat .
endv


fmod ARBOL-BINARIO-NAT is
  protecting ARBOL-BINARIO{vNat} .
endfm



red in ARBOL-BINARIO-NAT : es-arbol-vacio?(arbol-vacio) .
red in ARBOL-BINARIO-NAT : raiz(plantar(arbol-vacio, 7, arbol-vacio)) .
red in ARBOL-BINARIO-NAT : hijo-iz(plantar(plantar(arbol-vacio, 2, arbol-vacio), 7, arbol-vacio)) .
red in ARBOL-BINARIO-NAT : es-arbol-vacio?(plantar(arbol-vacio, 4, arbol-vacio)) .
red in ARBOL-BINARIO-NAT : hijo-dr(plantar(arbol-vacio, 4, arbol-vacio)) .
red in ARBOL-BINARIO-NAT : raiz(arbol-vacio) .


