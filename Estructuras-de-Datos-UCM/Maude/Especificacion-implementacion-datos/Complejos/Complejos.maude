fmod COMPLEJOS is 

  including INT .

  sort Complejo .

  op error : -> [Complejo] .
  op error : -> [Int] .

  op <_;_> : Int Int -> Complejo [ctor] .

  op re  : Complejo          -> Int .
  op im  : Complejo          -> Int .

  op _+_ : Complejo Complejo -> Complejo .
  op _-_ : Complejo Complejo -> Complejo .
  op _*_ : Complejo Complejo -> Complejo .
  op _/_ : Complejo Complejo ~> Complejo .

  op _==_ : Complejo Complejo -> Complejo .

  op conjugado : Complejo -> Complejo .

  vars A B C D : Int .

  eq re(< A ; B >) = A .
  eq im(< A ; B >) = B .

  vars C1 C2 C3 : Complejo .

  eq (C1 + C2) + C3 = C1 + (C2 + C3) [nonexec] .
  eq (C1 + C2) = (C2 + C1) [nonexec] . 

  eq < A ; B > + < C ; D > = < A + C ; B + D >  .
  eq < A ; B > - < C ; D > = < A - C ; B - D > .
  eq < A ; B > * < C ; D >  = < A * C - B * D ; A * D + C * B > .

  ceq < A ; B > / < C ; D >  = 
	     < (A * C + B * D) quo (C * C + D * D); (B * C - A * D) quo (C * C + D * D) > 
	     if C =/= 0 or D =/= 0 .
	     
  ceq < A ; B > / < C ; D >  = error if C == 0 /\ D == 0 .

  ceq < A ; B > == < C ; D > = true  if A == C /\ B == D .
  ceq < A ; B > == < C ; D > = false if A =/= C or B =/= D .

  op igual : Complejo Complejo -> Bool .
  eq igual(< A ; B > , < C ; D >) = (A == C) and (B == D) . 

  eq conjugado(< A ; B >) = < A ; - B > .

  op val : Complejo -> Int .
  eq val(< A ; B >) = A * A + B * B .

  op _^_ : Complejo Nat -> Complejo .

  var N : Nat .

  eq C1 ^ 0 = < 1 ; 0 > .
  eq C1 ^ s(N) = C1 * (C1 ^ N) .

 endfm
 

 --- red re(< 7 ; 9 >) .
 --- red im(< 7 ; 9 >) .

 --- red < 4 ; 9 > * < 6 ; 3 > .

 --- red (< 4 ; 9 > + < 6 ; 3 >) * < 5 ; 2 > . 
 --- red < 3 ; 7 > - < 5 ; 7 > .
 --- red < 6 ; 9 > / < 3 ; 2 > .

 --- red < 6 ; 8 > == < 8 ; 6 > .
 --- red < 6 ; 8 > == < 6 ; 8 > .

 --- red igual(< 6 ; 8 >, < 8 ; 6 >) .

 --- red conjugado(< 5 ; 2 > + < 3 ; 0 >) .

 --- red val(< 6 ; 8 >) .

 --- Operaciones asociativas

 --- red < 4 ; 9 > + < 6 ; 3 > + < 5 ; 2 > . 

 --- Operaciones conmutativas

 --- red < 4 ; 9 > + < 3 ; 7 > == < 3 ; 7 > + < 4 ; 9 > .
 --- red (< 7 ; 5 > == < 7 ; 5 >) == igual(< 7 ; 5 > , < 7 ; 5 >) .

 --- Potencia
	 
 --- red < 1 ; 1 > ^ 0 .
 --- red < 1 ; 1 > ^ 1 .
 --- red < 1 ; 1 > ^ 2 .
 --- red < 1 ; 1 > ^ 3 .
 --- red < 2 ; 0 > ^ 5 .
 --- red < 0 ; 1 > ^ 2 .
 --- red < 0 ; 1 > ^ 4 .

